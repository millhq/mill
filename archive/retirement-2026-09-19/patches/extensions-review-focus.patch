+++ b/frontend/src/views/ExtensionEnableButton.tsx
@@ -0,0 +1,15 @@
+import { Button } from '@primer/react'
+import { commandLabel, findCommand, runCommand } from '../shared/commands'
+import type { CommandContext } from '../shared/commandContext'
+import { EXTENSION_ENTITY } from '../shared/extensionsCommands'
+
+export function ExtensionEnableButton({ id, disabled }: { id: string; disabled: boolean }) {
+  const command = findCommand(disabled ? 'extension.enable' : 'extension.disable')
+  const context: CommandContext = { kind: 'entity', entity: EXTENSION_ENTITY, id }
+  if (!command || !(command.enabled?.(context) ?? true)) return null
+  return (
+    <Button size="small" onClick={() => void runCommand(command.id, context)} data-testid="extensions-detail-enable">
+      {commandLabel(command, context)}
+    </Button>
+  )
+}
