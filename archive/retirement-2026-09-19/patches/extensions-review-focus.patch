diff --git a/frontend/src/views/extensionInventory.test.ts b/frontend/src/views/extensionInventory.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b177837a5357ebc0811cb3e9d51ec32085682955
--- /dev/null
+++ b/frontend/src/views/extensionInventory.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import type { PluginInfo } from "../../bindings/github.com/alicoding/mill/internal/services/pluginsvc/models";
+import {
+  matchesExtension,
+  pluginNeedsReview,
+  pluginRowStatus,
+} from "./extensionInventory";
+
+function plugin(overrides: Partial<PluginInfo> = {}): PluginInfo {
+  return {
+    Manifest: {
+      id: "sample",
+      name: "Sample",
+      version: "1.0.0",
+      description: "Makes diagrams",
+    },
+    Builtin: false,
+    Tier: "verified",
+    Error: "",
+    ...overrides,
+  } as PluginInfo;
+}
+
+describe("extension inventory projections", () => {
+  it("keeps one status using the required priority", () => {
+    const item = plugin({ Error: "broken" });
+    expect(
+      pluginRowStatus({
+        plugin: item,
+        runtime: undefined,
+        status: "changed",
+        disabled: true,
+      }),
+    ).toEqual({ kind: "review" });
+    expect(
+      pluginRowStatus({
+        plugin: item,
+        runtime: undefined,
+        status: "policy",
+        disabled: true,
+      }),
+    ).toEqual({ kind: "blocked" });
+    expect(
+      pluginRowStatus({
+        plugin: item,
+        runtime: undefined,
+        status: "error",
+        disabled: true,
+      }),
+    ).toEqual({ kind: "error" });
+    expect(
+      pluginRowStatus({
+        plugin: plugin(),
+        runtime: undefined,
+        status: undefined,
+        disabled: true,
+      }),
+    ).toEqual({ kind: "disabled" });
+    expect(
+      pluginRowStatus({
+        plugin: plugin(),
+        runtime: undefined,
+        status: undefined,
+        disabled: false,
+      }),
+    ).toEqual({ kind: "trust", value: "verified" });
+  });
+
+  it("uses the shared review set and searches names and descriptions", () => {
+    expect(pluginNeedsReview("unallowed")).toBe(true);
+    expect(pluginNeedsReview("changed")).toBe(true);
+    expect(pluginNeedsReview("blocked")).toBe(false);
+    expect(matchesExtension("sample", "Sample", "Makes diagrams")).toBe(true);
+    expect(matchesExtension("diagram", "Sample", "Makes diagrams")).toBe(true);
+    expect(matchesExtension("missing", "Sample", "Makes diagrams")).toBe(false);
+  });
+});
diff --git a/frontend/src/views/extensionInventory.ts b/frontend/src/views/extensionInventory.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a1c62193670c33fd43eec1239b541e0169718969
--- /dev/null
+++ b/frontend/src/views/extensionInventory.ts
@@ -0,0 +1,69 @@
+import type { PluginInfo } from "../../bindings/github.com/alicoding/mill/internal/services/pluginsvc/models";
+import type { PluginLoadState } from "../plugins/loader";
+
+export type ExtensionRowStatusKind =
+  "review" | "blocked" | "error" | "waits" | "disabled" | "trust";
+
+export interface ExtensionRowStatus {
+  kind: ExtensionRowStatusKind;
+  value?: string;
+}
+
+export function pluginEffectiveStatus(
+  plugin: PluginInfo,
+  runtime: PluginLoadState | undefined,
+  allowedIds: readonly string[],
+): string | undefined {
+  if (runtime?.status) return runtime.status;
+  if (
+    !plugin.Builtin &&
+    (plugin.ApprovalState === "unallowed" || plugin.ApprovalState === "changed")
+  )
+    return plugin.ApprovalState;
+  if (!plugin.Builtin && plugin.ApprovalState !== "allowed") return "error";
+  if (plugin.ThemeImport && !allowedIds.includes(plugin.Manifest.id))
+    return "unallowed";
+  return undefined;
+}
+
+export function pluginNeedsReview(status: string | undefined): boolean {
+  return status === "unallowed" || status === "changed";
+}
+
+// A row carries one status only. The detail retains the lower-priority
+// facts, while this ordered projection keeps the inventory scannable.
+export function pluginRowStatus({
+  plugin,
+  runtime,
+  status,
+  disabled,
+}: {
+  plugin: PluginInfo;
+  runtime: PluginLoadState | undefined;
+  status: string | undefined;
+  disabled: boolean;
+}): ExtensionRowStatus {
+  if (pluginNeedsReview(status)) return { kind: "review" };
+  if (status === "policy" || status === "blocked" || status === "unsigned")
+    return { kind: "blocked" };
+  if (plugin.Error || status === "error") return { kind: "error" };
+  if (status === "waits") return { kind: "waits", value: runtime?.waitsFor };
+  if (disabled || status === "disabled") return { kind: "disabled" };
+  return {
+    kind: "trust",
+    value: plugin.Tier || (plugin.Builtin ? "built-in" : ""),
+  };
+}
+
+export function matchesExtension(
+  query: string,
+  name: string,
+  description?: string,
+): boolean {
+  const normalized = query.trim().toLowerCase();
+  if (normalized === "") return true;
+  return (
+    name.toLowerCase().includes(normalized) ||
+    (description ?? "").toLowerCase().includes(normalized)
+  );
+}
