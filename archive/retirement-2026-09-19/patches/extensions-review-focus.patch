--- /dev/null
+++ b/frontend/src/views/ExtensionsInventory.tsx
@@ -0,0 +1,134 @@
+import { ActionList, Button, Label, Text } from '@primer/react'
+import { ChevronDownIcon, ChevronRightIcon, PlugIcon } from '@primer/octicons-react'
+import { useTranslation } from 'react-i18next'
+import type { PluginInfo } from '../../bindings/github.com/alicoding/mill/internal/services/pluginsvc/models'
+import { pluginLoadStates } from '../plugins/loader'
+import type { ExtensionRowSource } from './extensionMeta'
+import { descriptionLabel } from './extensionMeta'
+import { ExtensionRow } from './ExtensionRow'
+import { tierLabelKey, tierVariant } from './extensionTrust'
+import { matchesExtension, pluginEffectiveStatus, pluginNeedsReview, pluginRowStatus, type ExtensionRowStatus } from './extensionInventory'
+import listStyles from '../shared/ListCard.module.css'
+
+export type ExtensionSelection = { kind: 'builtin' | 'plugin'; id: string } | null
+
+export function ExtensionsInventory({
+  query,
+  pending,
+  installed,
+  builtInRows,
+  builtInPlugins,
+  builtInCount,
+  builtInsExpanded,
+  allowedIds,
+  disabledIds,
+  selection,
+  onBuiltInsExpandedChange,
+  onSelect,
+}: {
+  query: string
+  pending: PluginInfo[]
+  installed: PluginInfo[]
+  builtInRows: ExtensionRowSource[]
+  builtInPlugins: PluginInfo[]
+  builtInCount: number
+  builtInsExpanded: boolean
+  allowedIds: string[]
+  disabledIds: string[]
+  selection: ExtensionSelection
+  onBuiltInsExpandedChange: (expanded: boolean) => void
+  onSelect: (selection: NonNullable<ExtensionSelection>) => void
+}) {
+  const { t } = useTranslation('views')
+  const runtimeStates = pluginLoadStates()
+  const filteredPending = pending.filter((plugin) => matchesExtension(query, plugin.Manifest.name || plugin.Manifest.id, plugin.Manifest.description))
+  const filteredInstalled = installed.filter((plugin) => matchesExtension(query, plugin.Manifest.name || plugin.Manifest.id, plugin.Manifest.description))
+  const filteredBuiltInRows = builtInRows.filter((row) => matchesExtension(query, row.label, descriptionLabel(row)))
+  const filteredBuiltInPlugins = builtInPlugins.filter((plugin) => matchesExtension(query, plugin.Manifest.name || plugin.Manifest.id, plugin.Manifest.description))
+  const filteredBuiltInCount = filteredBuiltInRows.length + filteredBuiltInPlugins.length
+  const expanded = query.trim() !== '' ? filteredBuiltInCount > 0 : builtInsExpanded
+  const noMatches = filteredPending.length === 0 && filteredInstalled.length === 0 && filteredBuiltInCount === 0
+
+  if (noMatches) {
+    return <Text as="p" size="small" className={listStyles.muted} data-testid="extensions-no-matches">{t('settings.extensions.noMatches', { query })}</Text>
+  }
+
+  return (
+    <ActionList role="listbox" selectionVariant="single" aria-label={t('settings.extensions.inventoryAria')} data-testid="extensions-action-list">
+      {filteredPending.length > 0 && (
+        <ActionList.Group data-testid="extensions-needs-review-group">
+          <ActionList.GroupHeading>{t('settings.extensions.needsReviewGroup', { count: pending.length })}</ActionList.GroupHeading>
+          {filteredPending.map((plugin) => renderPluginRow(plugin, true))}
+        </ActionList.Group>
+      )}
+      {filteredInstalled.length > 0 && (
+        <ActionList.Group data-testid="extensions-installed-group">
+          <ActionList.GroupHeading>{t('settings.extensions.installedTitle')}</ActionList.GroupHeading>
+          {filteredInstalled.map((plugin) => renderPluginRow(plugin, false))}
+        </ActionList.Group>
+      )}
+      {filteredBuiltInCount > 0 && (
+        <ActionList.Group data-testid="extensions-built-in-group">
+          <ActionList.GroupHeading>
+            <Button
+              variant="invisible"
+              size="small"
+              leadingVisual={expanded ? ChevronDownIcon : ChevronRightIcon}
+              aria-expanded={expanded}
+              onClick={() => onBuiltInsExpandedChange(!expanded)}
+              data-testid="extensions-built-in-toggle"
+            >
+              {t('settings.extensions.builtInCount', { count: query.trim() === '' ? builtInCount : filteredBuiltInCount })}
+            </Button>
+          </ActionList.GroupHeading>
+          {expanded && filteredBuiltInRows.map((row) => (
+            <ExtensionRow
+              key={`builtin:${row.id}`}
+              id={row.id}
+              icon={row.icon}
+              name={row.label}
+              description={descriptionLabel(row)}
+              selected={selection?.kind === 'builtin' && selection.id === row.id}
+              status={<Label data-testid="extensions-row-status">{disabledIds.includes(row.id) ? t('settings.extensions.statusOff') : t('settings.extensions.builtIn')}</Label>}
+              onSelect={() => onSelect({ kind: 'builtin', id: row.id })}
+            />
+          ))}
+          {expanded && filteredBuiltInPlugins.map((plugin) => renderPluginRow(plugin, false))}
+        </ActionList.Group>
+      )}
+    </ActionList>
+  )
+
+  function renderPluginRow(plugin: PluginInfo, review: boolean) {
+    const id = plugin.Manifest.id
+    const runtime = runtimeStates.get(id)
+    const effective = pluginEffectiveStatus(plugin, runtime, allowedIds)
+    const displayStatus = review ? effective : (pluginNeedsReview(effective) ? undefined : effective)
+    const status = pluginRowStatus({ plugin, runtime, status: displayStatus, disabled: disabledIds.includes(id) })
+    return (
+      <ExtensionRow
+        key={`plugin:${id}`}
+        id={id}
+        icon={PlugIcon}
+        name={plugin.Manifest.name || id}
+        description={plugin.Manifest.description}
+        selected={selection?.kind === 'plugin' && selection.id === id}
+        status={review ? undefined : <PluginStatus status={status} />}
+        reviewLabel={review ? t('settings.extensions.awaitingReviewAction') : undefined}
+        plugin
+        onSelect={() => onSelect({ kind: 'plugin', id })}
+      />
+    )
+  }
+
+  function PluginStatus({ status }: { status: ExtensionRowStatus }) {
