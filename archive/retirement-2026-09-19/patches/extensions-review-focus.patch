diff --git a/frontend/src/views/ExtensionCollectionMenu.tsx b/frontend/src/views/ExtensionCollectionMenu.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..67fdfb073b14e388667caff27f6919588a6cbf49
--- /dev/null
+++ b/frontend/src/views/ExtensionCollectionMenu.tsx
@@ -0,0 +1,25 @@
+import { ActionList, ActionMenu } from '@primer/react'
+import { useTranslation } from 'react-i18next'
+import { commandLabel, findCommand, runCommand } from '../shared/commands'
+import type { CommandContext } from '../shared/commandContext'
+
+const COLLECTION_COMMANDS = ['extensions.openPluginsFolder', 'extensions.reload', 'extensions.exportAudit', 'extensions.toggleAll', 'extensions.docs'] as const
+
+export function ExtensionCollectionMenu({ context, allOff }: { context: CommandContext; allOff: boolean }) {
+  const { t } = useTranslation('views')
+  return (
+    <ActionMenu>
+      <ActionMenu.Button size="small" data-testid="extensions-more-actions">{t('settings.extensions.moreActionsMenu')}</ActionMenu.Button>
+      <ActionMenu.Overlay>
+        <ActionList>
+          {COLLECTION_COMMANDS.flatMap((id) => {
+            const command = findCommand(id)
+            if (!command || !(command.enabled?.(context) ?? true)) return []
+            const label = id === 'extensions.toggleAll' ? t(allOff ? 'settings.extensions.turnAllOn' : 'settings.extensions.turnAllOff') : commandLabel(command)
+            return [<ActionList.Item key={id} onSelect={() => void runCommand(id, context)} data-testid={`extensions-more-${id.split('.').pop()}`}>{label}</ActionList.Item>]
+          })}
+        </ActionList>
+      </ActionMenu.Overlay>
+    </ActionMenu>
+  )
+}
