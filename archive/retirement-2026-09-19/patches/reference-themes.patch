+	writeTestIcon(t, executable)
+	if problems := ConformDir(executable, ""); len(problems) != 0 {
+		t.Fatalf("executable metadata problems = %v", problems)
+	}
+
+	themeFiles := metadataFiles()
+	themeFiles["theme.css"] = "--bgColor-default: #ffffff;"
+	themeFiles["source.json"] = `{"colors":{"editor.background":"#ffffff"}}`
+	theme := writeConformPlugin(t, t.TempDir(), "documented-theme", `{"id":"documented-theme","name":"Documented theme","version":"1.0.0","icon":"icon.png","capabilities":[],"contributes":{"themes":[{"id":"theme","label":"Documented theme","family":"light","file":"theme.css"}]}}`, themeFiles)
+	writeTestIcon(t, theme)
+	if problems := ConformDir(theme, ""); len(problems) != 0 {
+		t.Fatalf("data-only metadata problems = %v", problems)
+	}
+}
+
+func TestConformFiles_RejectsMetadataLookalikes(t *testing.T) {
+	dir := t.TempDir()
+	rejected := []string{
+		"notes.md", "arbitrary.txt", "readme.md", "license.txt",
+		filepath.Join("nested", "README.md"), filepath.Join("nested", "LICENSE.txt"),
+		"image.gif",
+	}
+	for _, rel := range rejected {
+		path := filepath.Join(dir, rel)
+		if err := os.MkdirAll(filepath.Dir(path), 0o750); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte("content"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	joined := strings.Join(conformFiles(dir), "\n")
+	for _, rel := range rejected {
+		want := rel + ": file is neither a supported plugin asset nor root package documentation or a license notice"
+		if !strings.Contains(joined, want) {
+			t.Errorf("missing %q in %q", want, joined)
+		}
+	}
+}
+
+func TestConformFiles_RejectsEscapingMetadataSymlink(t *testing.T) {
+	root := t.TempDir()
+	dir := filepath.Join(root, "plugin")
+	if err := os.MkdirAll(dir, 0o750); err != nil {
+		t.Fatal(err)
+	}
+	outside := filepath.Join(root, "outside.md")
+	if err := os.WriteFile(outside, []byte("outside"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(dir, string(PluginDocOverview))); err != nil {
+		t.Skip("symlinks unavailable here")
+	}
+	joined := strings.Join(conformFiles(dir), "\n")
+	if !strings.Contains(joined, "README.md: a symlink must stay inside the plugin folder") {
+		t.Fatalf("escaping metadata symlink problems = %q", joined)
+	}
+}
+
+func TestEntryProblem_RejectsSpecialPackageMetadataFiles(t *testing.T) {
+	root := t.TempDir()
+	for _, name := range []string{string(PluginDocOverview), "LICENSE.txt"} {
+		problem, _ := entryProblem(root, filepath.Join(root, name), name, specialMetadataDirEntry{name: name})
+		want := name + ": file is neither a supported plugin asset nor root package documentation or a license notice"
+		if problem != want {
+			t.Errorf("entryProblem(%s) = %q, want %q", name, problem, want)
+		}
+	}
+}
+
+func TestPackageDocuments_UseDocumentAPIsAndNeverTheAssetRoute(t *testing.T) {
+	root := t.TempDir()
+	files := metadataFiles()
+	writePlugin(t, root, "documented-one", `{"id":"documented-one","name":"Documented","version":"1.0.0"}`, files)
+	svc := New(root, nil, "1.0.0")
+
+	for _, name := range []string{string(PluginDocOverview), string(PluginDocChangelog)} {
+		got, err := svc.ReadPluginDoc("documented-one", name)
+		if err != nil || got != name+" contents" {
+			t.Errorf("ReadPluginDoc(%s) = %q, %v", name, got, err)
+		}
+	}
+	bundledRoot := t.TempDir()
+	bundledPlugins := filepath.Join(bundledRoot, exampleMarketplaceRoot)
+	writePlugin(t, bundledPlugins, "documented-one", `{"id":"documented-one","name":"Documented","version":"1.0.0"}`, files)
+	svc.SetExampleMarketplace(os.DirFS(bundledRoot))
+	if got, err := svc.ReadMarketplaceDoc(ReservedMarketplaceName, "documented-one"); err != nil || got != string(PluginDocOverview)+" contents" {
+		t.Errorf("ReadMarketplaceDoc() = %q, %v", got, err)
+	}
+	for _, name := range permittedRootMetadata {
+		rec := serveThrough(t, svc, "/plugins/documented-one/"+name)
+		if rec.Code != http.StatusNotFound {
+			t.Errorf("GET %s = %d, want 404", name, rec.Code)
+		}
+	}
+	if rec := serveThrough(t, svc, "/plugins/documented-one/main.js"); rec.Code != http.StatusOK {
+		t.Fatalf("GET main.js = %d, want 200", rec.Code)
+	}
+}
