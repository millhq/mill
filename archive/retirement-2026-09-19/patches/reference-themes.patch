+
+func (s *FileStore) Get(key string) any {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.store.Get(key)
+}
+
+func (s *FileStore) Set(key string, value any) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.store.Set(key, value); err != nil {
+		s.saveErr = err
+		return err
+	}
+	s.persisted = true
+	s.saveErr = nil
+	return nil
