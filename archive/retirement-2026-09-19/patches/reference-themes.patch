+type specialMetadataDirEntry struct {
+	name string
+}
+
+func (e specialMetadataDirEntry) Name() string             { return e.name }
+func (specialMetadataDirEntry) IsDir() bool                { return false }
+func (specialMetadataDirEntry) Type() fs.FileMode          { return fs.ModeNamedPipe }
+func (specialMetadataDirEntry) Info() (fs.FileInfo, error) { return nil, nil }
+
+var permittedRootMetadata = []string{
+	string(PluginDocOverview), string(PluginDocChangelog),
+	"LICENSE", "LICENSE.md", "LICENSE.txt",
+	"NOTICE", "NOTICE.md", "NOTICE.txt",
+}
+
+func metadataFiles() map[string]string {
+	files := make(map[string]string, len(permittedRootMetadata))
