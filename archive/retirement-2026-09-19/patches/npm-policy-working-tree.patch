diff --git a/scripts/vite-css-modules-selftest.mjs b/scripts/vite-css-modules-selftest.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1999e780544152263cee36713456d25e20d39bba
--- /dev/null
+++ b/scripts/vite-css-modules-selftest.mjs
@@ -0,0 +1,475 @@
+import assert from 'node:assert/strict'
+import { mkdtemp, readFile, realpath, rm, writeFile } from 'node:fs/promises'
+import { createRequire } from 'node:module'
+import os from 'node:os'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+const frontendRoot = path.resolve(import.meta.dirname, '../frontend')
+const requireFrontend = createRequire(path.join(frontendRoot, 'package.json'))
+
+async function importFrontend(packageName) {
+  return import(pathToFileURL(requireFrontend.resolve(packageName)).href)
+}
+
+const [{ build, createLogger, createServer }, { patchCssModules }, postcssModule] = await Promise.all([
+  importFrontend('vite'),
+  importFrontend('vite-css-modules'),
+  importFrontend('postcss'),
+])
+const postcss = postcssModule.default ?? postcssModule
+const proveHmr = process.argv.includes('--hmr')
+
+const fixtureRoot = await realpath(await mkdtemp(path.join(os.tmpdir(), 'mill-vite-css-modules-')))
+const messages = { warnings: [], errors: [], environments: [] }
+
+function capturingLogger() {
+  const logger = createLogger('silent')
+  logger.warn = message => messages.warnings.push(String(message))
+  logger.warnOnce = message => messages.warnings.push(String(message))
+  logger.error = message => messages.errors.push(String(message))
+  return logger
+}
+
+function outputs(result) {
+  return (Array.isArray(result) ? result : [result]).flatMap(item => item.output)
+}
+
+function textAsset(output) {
+  return typeof output.source === 'string' ? output.source : Buffer.from(output.source).toString('utf8')
+}
+
+function declarationCount(css, property, value) {
+  let count = 0
+  postcss.parse(css).walkDecls(property, declaration => {
+    if (declaration.value === value) count += 1
+  })
+  return count
+}
+
+async function loadChromium() {
+  const playwright = await importFrontend('@playwright/test')
+  const chromium = playwright.chromium ?? playwright.default?.chromium
+  assert(chromium, '@playwright/test must expose Chromium')
+  return chromium
+}
+
+async function buildFixture(entry, root = fixtureRoot) {
+  const nodeEnvBefore = process.env.NODE_ENV
+  try {
+    return await build({
+      root,
+      configFile: false,
+      customLogger: capturingLogger(),
+      plugins: [patchCssModules()],
+      build: {
+        target: 'es2022',
+        write: false,
+        minify: false,
+        cssMinify: false,
+        lib: {
+          entry: path.isAbsolute(entry) ? entry : path.join(fixtureRoot, entry),
+          formats: ['es'],
+          fileName: 'proof',
+        },
+      },
+    })
+  } finally {
+    messages.environments.push({ phase: 'build', before: nodeEnvBefore ?? null, after: process.env.NODE_ENV ?? null })
+    if (nodeEnvBefore === undefined) delete process.env.NODE_ENV
+    else process.env.NODE_ENV = nodeEnvBefore
+  }
+}
+
+async function writeValidFixture() {
+  await Promise.all([
+    writeFile(path.join(fixtureRoot, 'shared.module.css'), [
+      '.shared {',
+      '  --mill-shared-proof: present;',
+      '  color: rgb(17, 34, 51);',
+      '}',
+      '',
+    ].join('\n')),
+    writeFile(path.join(fixtureRoot, 'consumer-a.module.css'), [
+      '.consumerA {',
+      "  composes: shared from './shared.module.css';",
+      '  --mill-consumer-a-proof: present;',
+      '}',
+      '',
+    ].join('\n')),
+    writeFile(path.join(fixtureRoot, 'consumer-b.module.css'), [
+      '.consumerB {',
+      "  composes: shared from './shared.module.css';",
+      '  --mill-consumer-b-proof: present;',
+      '}',
+      '',
+    ].join('\n')),
+    writeFile(path.join(fixtureRoot, 'build-entry.js'), [
+      "import a from './consumer-a.module.css'",
+      "import b from './consumer-b.module.css'",
+      'export const classNames = [a.consumerA, b.consumerB]',
+      '',
+    ].join('\n')),
+  ])
+}
+
+async function proveBuildPipeline() {
+  const result = await buildFixture('build-entry.js')
+  const output = outputs(result)
+  const css = output.filter(item => item.type === 'asset' && item.fileName.endsWith('.css')).map(textAsset).join('\n')
+  const entry = output.find(item => item.type === 'chunk' && item.isEntry)
+
+  assert(entry, 'Vite build did not emit an entry chunk')
+  assert.equal(declarationCount(css, '--mill-shared-proof', 'present'), 1, 'shared composed CSS must be emitted once')
+  assert.equal(declarationCount(css, '--mill-consumer-a-proof', 'present'), 1, 'first consumer CSS must be emitted once')
+  assert.equal(declarationCount(css, '--mill-consumer-b-proof', 'present'), 1, 'second consumer CSS must be emitted once')
+
+  const module = await import(`data:text/javascript;base64,${Buffer.from(entry.code).toString('base64')}`)
+  assert.equal(module.classNames.length, 2)
+  assert(module.classNames.every(value => typeof value === 'string' && !value.includes('undefined')), 'composed exports must resolve to class names')
+  const [firstTokens, secondTokens] = module.classNames.map(value => new Set(value.split(/\s+/)))
+  assert.equal([...firstTokens].filter(token => secondTokens.has(token)).length, 1, 'both consumers must share exactly the composed class')
+  assert(!messages.warnings.some(message => message.includes('did not pass the `from` option')), 'build must not emit the PostCSS missing-source warning')
+}
+
+async function proveMillConsumersShareProse() {
+  const consumers = [
+    ['docs', path.join(frontendRoot, 'src/views/DocsView.module.css'), 'article'],
+    ['note', path.join(frontendRoot, 'src/atlas/MarkdownNoteField.module.css'), 'rendered'],
+    ['diagram', path.join(frontendRoot, 'src/atlas/AtlasUnitMermaid.module.css'), 'diagramHost'],
+    ['mirror', path.join(frontendRoot, 'src/atlas/AtlasCardMirrorPreview.module.css'), 'markdownBody'],
+  ]
+  const imports = consumers.map(([binding, file]) => `import ${binding} from ${JSON.stringify(file)}`)
+  const values = consumers.map(([binding, , className]) => `${binding}.${className}`)
+  const entryPath = path.join(fixtureRoot, 'mill-consumers-entry.js')
+  await writeFile(entryPath, `${imports.join('\n')}\nexport const classNames = [${values.join(', ')}]\n`)
+
+  const result = await buildFixture(entryPath, frontendRoot)
+  const output = outputs(result)
+  const css = output.filter(item => item.type === 'asset' && item.fileName.endsWith('.css')).map(textAsset).join('\n')
+  const entry = output.find(item => item.type === 'chunk' && item.isEntry)
+  assert(entry, 'Mill consumer build did not emit an entry chunk')
+
+  const module = await import(`data:text/javascript;base64,${Buffer.from(entry.code).toString('base64')}`)
+  assert.equal(module.classNames.length, 4, 'all four Markdown prose consumers must be built')
+  assert(module.classNames.every(value => typeof value === 'string' && !value.includes('undefined')), 'every Mill consumer must resolve its composed prose class')
+  const tokenSets = module.classNames.map(value => new Set(value.split(/\s+/)))
+  const sharedTokens = [...tokenSets[0]].filter(token => tokenSets.slice(1).every(tokens => tokens.has(token)))
+  assert.equal(sharedTokens.length, 1, 'all four Mill consumers must share exactly one Markdown prose class')
+  const cssRoot = postcss.parse(css)
+  let proseTypographyRules = 0
+  let mermaidDescendantRules = 0
+  cssRoot.walkRules(rule => {
+    if (!rule.selector.includes(`.${sharedTokens[0]}`)) return
+    rule.walkDecls('line-height', declaration => {
+      if (declaration.value === '1.5') proseTypographyRules += 1
+    })
+    if (rule.selector.includes('.atlas-mermaid-diagram')) mermaidDescendantRules += 1
+  })
+  assert.equal(proseTypographyRules, 1, 'the built shared class must retain Markdown prose typography')
+  assert(mermaidDescendantRules >= 1, 'the built shared class must retain Markdown prose global descendant styles')
+}
+
+async function proveMissingClassRefusal() {
+  await writeFile(path.join(fixtureRoot, 'missing.module.css'), [
+    '.broken {',
+    "  composes: absent from './shared.module.css';",
+    '}',
+    '',
+  ].join('\n'))
+  await writeFile(path.join(fixtureRoot, 'missing-entry.js'), "import styles from './missing.module.css'\nexport default styles.broken\n")
+
+  const loggedErrorsBefore = messages.errors.length
+  await assert.rejects(
+    buildFixture('missing-entry.js'),
+    error => /Cannot resolve "absent" from "\.\/shared\.module\.css"/.test(String(error)),
+    'a missing composed class must fail the Vite build',
+  )
+  messages.errors.splice(loggedErrorsBefore)
+}
+
+async function proveHmrPreservesState() {
+  const chromium = await loadChromium()
+  const reactPlugin = (await importFrontend('@vitejs/plugin-react')).default
+  const sharedPath = path.join(fixtureRoot, 'shared.module.css')
+  const sharedCss = await readFile(sharedPath, 'utf8')
+  const fixtureFiles = ['index.html', 'hmr-observer.js', 'dev-component.jsx', 'dev-entry.jsx'].map(file => path.join(fixtureRoot, file))
+
+  async function runTrial(label, plugins) {
+    const nodeEnvBefore = process.env.NODE_ENV
+    let server
+    let browser
+    let page
+    const navigations = []
+    const websocketFrames = []
+    try {
+      server = await createServer({
+        root: fixtureRoot,
+        configFile: false,
+        customLogger: capturingLogger(),
+        plugins,
+        resolve: {
+          alias: [
+            { find: /^react$/, replacement: requireFrontend.resolve('react') },
+            { find: /^react-dom\/client$/, replacement: requireFrontend.resolve('react-dom/client') },
+          ],
+        },
+        server: { host: '127.0.0.1', port: 0, strictPort: false },
+      })
+      await server.listen()
+      const writtenFiles = [...fixtureFiles, sharedPath]
+      const fixtureWritesObserved = new Promise((resolve, reject) => {
+        const pending = new Set(writtenFiles)
+        const cleanup = () => {
+          server.watcher.off('add', onFile)
+          server.watcher.off('change', onFile)
+        }
+        const timeout = setTimeout(() => {
+          cleanup()
+          reject(new Error(`Vite watcher did not observe fixture writes: ${[...pending].join(', ')}`))
+        }, 5_000)
+        const onFile = file => {
+          pending.delete(path.isAbsolute(file) ? file : path.join(fixtureRoot, file))
+          if (pending.size > 0) return
+          clearTimeout(timeout)
+          cleanup()
+          resolve()
+        }
+        server.watcher.on('add', onFile)
+        server.watcher.on('change', onFile)
+      })
+      await Promise.all([
+        writeFile(fixtureFiles[0], '<div id="app"></div><script type="module" src="/dev-entry.jsx"></script>\n'),
+        writeFile(fixtureFiles[1], [
+          'globalThis.__millHmrEvents = []',
+          'if (import.meta.hot) {',
+          "  import.meta.hot.on('vite:beforeUpdate', payload => globalThis.__millHmrEvents.push({ type: payload.type, updates: payload.updates.map(update => ({ type: update.type, path: update.path, acceptedPath: update.acceptedPath })) }))",
+          "  import.meta.hot.on('vite:beforeFullReload', payload => globalThis.__millHmrEvents.push({ type: payload.type, path: payload.path, triggeredBy: payload.triggeredBy }))",
+          '}',
+          '',
+        ].join('\n')),
+        writeFile(fixtureFiles[2], [
+          "import { createElement, useState } from 'react'",
+          "import styles from './consumer-a.module.css'",
+          'globalThis.__millComponentModuleLoads = (globalThis.__millComponentModuleLoads ?? 0) + 1',
+          'export function Fixture() {',
+          "  const [value, setValue] = useState('')",
+          "  return createElement('div', null,",
+          "    createElement('input', { id: 'state', value, onChange: event => setValue(event.target.value) }),",
+          "    createElement('div', { id: 'target', className: styles.consumerA }, 'proof'),",
+          '  )',
+          '}',
+          '',
+        ].join('\n')),
+        writeFile(fixtureFiles[3], [
+          "import './hmr-observer.js'",
+          "import { createElement } from 'react'",
+          "import { createRoot } from 'react-dom/client'",
+          "import { Fixture } from './dev-component.jsx'",
+          'globalThis.__millRootModuleLoads = (globalThis.__millRootModuleLoads ?? 0) + 1',
+          "createRoot(document.querySelector('#app')).render(createElement(Fixture))",
+          '',
+        ].join('\n')),
+        writeFile(sharedPath, sharedCss),
+      ])
+      await fixtureWritesObserved
+      const transformedComponent = await server.transformRequest('/dev-component.jsx')
+      const refreshRegistered = Boolean(
+        transformedComponent?.code.includes('$RefreshReg$')
+        && transformedComponent.code.includes('import.meta.hot.accept'),
+      )
+
+      const address = server.httpServer?.address()
+      assert(address && typeof address === 'object', 'Vite did not expose its OS-assigned port')
+      browser = await chromium.launch({ headless: true })
+      page = await browser.newPage()
+      page.on('framenavigated', frame => {
+        if (frame === page.mainFrame()) navigations.push(frame.url())
+      })
+      page.on('websocket', socket => {
+        socket.on('framereceived', frame => websocketFrames.push(String(frame.payload)))
+      })
+      await page.goto(`http://127.0.0.1:${address.port}/`)
+      await server.waitForRequestsIdle()
+      await page.locator('#state').waitFor()
+      await page.locator('#state').fill('retained state')
+      assert.equal(await page.locator('#state').inputValue(), 'retained state', `${label} control input must hold state before the CSS edit`)
+      await page.waitForFunction(() => getComputedStyle(document.querySelector('#target')).color === 'rgb(17, 34, 51)')
+
+      const navigationCountBeforeEdit = navigations.length
+      const websocketCountBeforeEdit = websocketFrames.length
+      await writeFile(sharedPath, sharedCss.replace('rgb(17, 34, 51)', 'rgb(51, 68, 85)'))
+      const colorUpdated = await page.waitForFunction(
+        () => getComputedStyle(document.querySelector('#target')).color === 'rgb(51, 68, 85)',
+        undefined,
+        { timeout: 5_000 },
+      ).then(() => true, () => false)
+      const observed = await page.evaluate(() => ({
+        events: globalThis.__millHmrEvents,
+        componentModuleLoads: globalThis.__millComponentModuleLoads,
+        rootModuleLoads: globalThis.__millRootModuleLoads,
+      }))
+      return {
+        label,
+        colorUpdated,
+        nodeEnvBefore: nodeEnvBefore ?? null,
+        nodeEnvDuring: process.env.NODE_ENV ?? null,
+        serverIsProduction: server.config.isProduction,
+        refreshRegistered,
+        inputValue: await page.locator('#state').inputValue(),
+        navigationCountBeforeEdit,
+        navigations,
+        websocketFrames: websocketFrames.slice(websocketCountBeforeEdit),
+        ...observed,
+      }
+    } finally {
+      await page?.close()
+      await browser?.close()
+      await server?.close()
+      messages.environments.push({ phase: `dev-${label}`, before: nodeEnvBefore ?? null, after: process.env.NODE_ENV ?? null })
+      if (nodeEnvBefore === undefined) delete process.env.NODE_ENV
+      else process.env.NODE_ENV = nodeEnvBefore
+    }
+  }
+
+  const baseline = await runTrial('baseline', [reactPlugin()])
+  const patched = await runTrial('patched', [patchCssModules(), reactPlugin()])
+  console.log(`vite-css-modules-hmr-evidence: ${JSON.stringify({ baseline, patched })}`)
+  assert.equal(baseline.colorUpdated, false, 'unpatched Vite must expose the shared composed-CSS HMR gap')
+  assert.equal(baseline.inputValue, 'retained state', 'the baseline control must retain React state when no update propagates')
+  assert.equal(baseline.serverIsProduction, false, 'baseline control must run in Vite development mode')
+  assert.equal(baseline.refreshRegistered, true, 'baseline control must register React Fast Refresh')
+  assert.equal(patched.colorUpdated, true, 'patched Vite must propagate the shared composed-CSS update')
+  assert.equal(patched.inputValue, 'retained state', 'patched CSS HMR must preserve React input state')
+  assert.equal(patched.serverIsProduction, false, 'patched control must run in Vite development mode')
+  assert.equal(patched.refreshRegistered, true, 'patched control must register React Fast Refresh')
+  assert.equal(patched.navigations.length, patched.navigationCountBeforeEdit, 'patched CSS HMR must not navigate the main frame')
+  assert.equal(patched.rootModuleLoads, 1, 'patched CSS HMR must not reload the application root module')
+  assert(patched.componentModuleLoads >= 1, 'patched CSS HMR must load the React CSS consumer')
+  assert(patched.events.some(event => event.type === 'update'), 'patched CSS HMR must expose a Vite update payload')
+  assert(!patched.events.some(event => event.type === 'full-reload'), 'patched CSS HMR must not expose a Vite full reload payload')
+}
+
+async function captureMillConsumerStyles(browser, plugins) {
+  const consumers = [
+    ['docs', path.join(frontendRoot, 'src/views/DocsView.module.css'), 'article'],
+    ['note', path.join(frontendRoot, 'src/atlas/MarkdownNoteField.module.css'), 'rendered'],
+    ['diagram', path.join(frontendRoot, 'src/atlas/AtlasUnitMermaid.module.css'), 'diagramHost'],
+    ['mirror', path.join(frontendRoot, 'src/atlas/AtlasCardMirrorPreview.module.css'), 'markdownBody'],
+  ]
+  const imports = consumers.map(([binding, file]) => `import ${binding} from ${JSON.stringify(`/@fs${file}`)}`)
+  const sections = consumers.map(([binding, , className]) => [
+    `const ${binding}Root = document.createElement('section')`,
+    `${binding}Root.dataset.consumer = '${binding}'`,
+    `${binding}Root.className = ${binding}.${className}`,
+    `${binding}Root.innerHTML = '<a>link</a><code>code</code><pre>pre</pre><table><tbody><tr><td>cell</td></tr></tbody></table><div class="atlas-mermaid-diagram"><svg></svg></div>'`,
+    `document.body.append(${binding}Root)`,
+  ].join('\n'))
+  await writeFile(path.join(fixtureRoot, 'mill-browser-entry.js'), [
+    ...imports,
+    ...sections,
+    'globalThis.__millStylesReady = true',
+    '',
+  ].join('\n'))
+  await writeFile(path.join(fixtureRoot, 'mill-browser.html'), [
+    '<style>:root { --fgColor-default: rgb(9, 18, 27); --bgColor-muted: rgb(220, 221, 222); --borderColor-default: rgb(60, 61, 62); --borderRadius-small: 3px; --borderRadius-medium: 6px; --base-size-4: 4px; --base-size-8: 8px; --base-size-12: 12px; --stack-gap-normal: 16px; }</style>',
+    '<script type="module" src="/mill-browser-entry.js"></script>',
+    '',
+  ].join('\n'))
+
+  const server = await createServer({
+    root: fixtureRoot,
+    configFile: false,
+    customLogger: capturingLogger(),
+    plugins,
+    server: {
+      host: '127.0.0.1',
+      port: 0,
+      strictPort: false,
+      fs: { allow: [fixtureRoot, frontendRoot] },
+    },
+  })
+  try {
+    await server.listen()
+    const address = server.httpServer?.address()
+    assert(address && typeof address === 'object', 'Vite did not expose its OS-assigned comparison port')
+    const page = await browser.newPage()
+    const diagnostics = []
+    page.on('console', message => diagnostics.push(`console ${message.type()}: ${message.text()}`))
+    page.on('pageerror', error => diagnostics.push(`pageerror: ${error.message}`))
+    page.on('requestfailed', request => diagnostics.push(`requestfailed ${request.url()}: ${request.failure()?.errorText ?? 'unknown'}`))
+    const response = await page.goto(`http://127.0.0.1:${address.port}/mill-browser.html`)
+    diagnostics.push(`document status: ${response?.status() ?? 'none'}`)
+    try {
+      await page.waitForFunction(() => globalThis.__millStylesReady === true, undefined, { timeout: 10_000 })
+    } catch (error) {
+      throw new Error(`Mill consumer fixture did not become ready:\n${diagnostics.join('\n')}`, { cause: error })
+    }
+    const styles = await page.locator('[data-consumer]').evaluateAll(elements => elements.map(element => {
+      const root = getComputedStyle(element)
+      const anchor = getComputedStyle(element.querySelector('a'))
+      const code = getComputedStyle(element.querySelector('code'))
+      const pre = getComputedStyle(element.querySelector('pre'))
+      const table = getComputedStyle(element.querySelector('table'))
