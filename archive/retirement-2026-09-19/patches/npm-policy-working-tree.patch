index 0000000000000000000000000000000000000000..90a45154f803511d9dc0547b4bc69e471425a6e0
--- /dev/null
+++ b/scripts/npm-lock-policy.mjs
@@ -0,0 +1,262 @@
+import { access, readFile } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import { loadPinnedNpm } from './npm-runtime.mjs'
+
+const DAY_MS = 24 * 60 * 60 * 1000
+const MINIMUM_AGE_DAYS = 7
+const BASELINE_COMMIT = '2fac32290622c94b9a0d8d569e8f5a3a6352ee3b'
+const POLICY_PATH = path.join(path.dirname(fileURLToPath(import.meta.url)), 'npm-policy.json')
+
+const exists = file => access(file).then(() => true, () => false)
+
+function parseArgs(args) {
+  let cwd = process.cwd()
+  let allowMissingLock = false
+  const npmArgs = []
+  for (let i = 0; i < args.length; i += 1) {
+    if (args[i] === '--cwd') {
+      if (!args[i + 1]) throw new Error('--cwd requires a path')
+      cwd = path.resolve(args[i + 1])
+      i += 1
+    } else if (args[i] === '--allow-missing-lock') {
+      allowMissingLock = true
+    } else if (args[i] === '--npm-arg') {
+      if (!args[i + 1]) throw new Error('--npm-arg requires a value')
+      npmArgs.push(args[i + 1])
+      i += 1
+    } else {
+      throw new Error(`unknown npm policy argument: ${args[i]}`)
+    }
+  }
+  return { cwd, allowMissingLock, npmArgs }
+}
+
+function artifactIdentity(raw, label) {
+  let url
+  try {
+    url = new URL(raw)
+  } catch {
+    throw new Error(`${label} has an invalid artifact URL`)
+  }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
+    throw new Error(`${label} has an unsupported or credential-bearing artifact URL`)
+  }
+  return `${url.protocol}//${url.host}${url.pathname}`
+}
+
+function lockedIdentity(node, npa, cwd) {
+  const sourceNames = new Set()
+  for (const edge of node.edgesIn) {
+    let source
+    try {
+      source = npa.resolve(edge.name, edge.spec, cwd)
+    } catch {
+      source = null
+    }
+    if (!source?.registry) continue
+    sourceNames.add(source.type === 'alias' ? source.subSpec?.name : source.name)
+  }
+  const [name] = sourceNames
+  const version = node.version
+  const spec = name && version ? npa.resolve(name, version, cwd) : null
+  const bundleDeclarations = [node.package.bundleDependencies, node.package.bundledDependencies]
+  const hasBundledDependencies = bundleDeclarations.some(value =>
+    value !== undefined && value !== false && (!Array.isArray(value) || value.length > 0)
+  )
+  if (
+    node.isLink || node.isWorkspace || node.inDepBundle || hasBundledDependencies ||
+    !node.isRegistryDependency || sourceNames.size !== 1 ||
+    node.packageName !== name || !spec?.registry || spec.type !== 'version'
+  ) {
+    const display = name && version ? `${name}@${version}` : node.location
+    throw new Error(`npm policy refuses unsupported dependency source: ${display}`)
+  }
+  if (!name || !version || !node.resolved || !node.integrity) {
+    throw new Error(`npm policy requires complete registry identity at ${node.location}`)
+  }
+  return {
+    name,
+    version,
+    resolved: artifactIdentity(node.resolved, `${name}@${version}`),
+    integrity: node.integrity,
+  }
+}
+
+function validateDeclaredSources(tree, npa, cwd) {
+  for (const node of tree.inventory.values()) {
+    for (const edge of node.edgesOut.values()) {
+      let source
+      try {
+        source = npa.resolve(edge.name, edge.spec, cwd)
+      } catch {
+        source = null
+      }
+      if (!source?.registry || (source.type === 'alias' && !source.subSpec?.registry)) {
+        throw new Error(`npm policy refuses unsupported dependency source: ${edge.name}`)
+      }
+    }
+  }
+}
+
+function exactAdmission(admissions, locked, published) {
+  return admissions.some(entry =>
+    entry.name === locked.name &&
+    entry.version === locked.version &&
+    entry.integrity === locked.integrity &&
+    entry.published === published
+  )
+}
+
+function validatePolicyRecord(policy) {
+  if (
+    policy.minimumAgeDays !== MINIMUM_AGE_DAYS ||
+    policy.baselineCommit !== BASELINE_COMMIT ||
+    !Array.isArray(policy.existingPinAdmissions)
+  ) {
+    throw new Error('npm policy record does not match the reviewed rollout boundary')
+  }
+  const identities = new Set()
+  for (const entry of policy.existingPinAdmissions) {
+    if (
+      typeof entry.name !== 'string' || !entry.name ||
+      typeof entry.version !== 'string' || !entry.version ||
+      typeof entry.integrity !== 'string' || !entry.integrity ||
+      !Number.isFinite(Date.parse(entry.published))
+    ) {
+      throw new Error('npm policy record contains an incomplete existing-pin admission')
+    }
+    const identity = `${entry.name}\0${entry.version}\0${entry.integrity}\0${entry.published}`
+    if (identities.has(identity)) {
+      throw new Error(`npm policy record repeats ${entry.name}@${entry.version}`)
+    }
+    identities.add(identity)
+  }
+}
+
+async function validatePackage({ name, locked, pacote, ssri, config, cutoff, now, admissions }) {
+  let packument
+  try {
+    packument = await pacote.packument(name, { ...config.flat, fullMetadata: true })
+  } catch (error) {
+    throw new Error(`npm policy could not read registry metadata for ${name}: ${error.code ?? 'request failed'}`)
+  }
+
+  for (const entry of locked) {
+    const manifest = packument.versions?.[entry.version]
+    if (!manifest || manifest.name !== entry.name || manifest.version !== entry.version) {
+      throw new Error(`npm policy found no matching registry version for ${entry.name}@${entry.version}`)
+    }
+    const published = packument.time?.[entry.version]
+    const publishedAt = Date.parse(published)
+    if (!Number.isFinite(publishedAt)) {
+      throw new Error(`npm policy found no valid publication time for ${entry.name}@${entry.version}`)
+    }
+    if (publishedAt > now) {
+      throw new Error(`npm policy refuses future publication time for ${entry.name}@${entry.version}`)
+    }
+
+    const registryArtifact = artifactIdentity(
+      manifest.dist?.tarball,
+      `${entry.name}@${entry.version} registry metadata`
+    )
+    if (registryArtifact !== entry.resolved) {
+      throw new Error(`npm policy artifact identity mismatch for ${entry.name}@${entry.version}`)
+    }
+
+    let lockedIntegrity
+    let registryIntegrity
+    try {
+      lockedIntegrity = ssri.parse(entry.integrity, { strict: true })
+      registryIntegrity = ssri.parse(manifest.dist?.integrity, { strict: true })
+    } catch {
+      throw new Error(`npm policy found invalid integrity for ${entry.name}@${entry.version}`)
+    }
