+++ b/scripts/npm-runtime.mjs
@@ -0,0 +1,76 @@
+import { realpath, readFile } from 'node:fs/promises'
+import { createRequire } from 'node:module'
+import path from 'node:path'
+
+export const EXPECTED_NODE_VERSION = '24.21.0'
+export const EXPECTED_NPM_VERSION = '12.0.2'
+
+const EXPECTED_PACKAGES = new Map([
+  ['@npmcli/arborist', '10.0.2'],
+  ['@npmcli/config', '11.0.1'],
+  ['npm-package-arg', '14.0.0'],
+  ['pacote', '22.0.0'],
+])
+
+const readJSON = async file => JSON.parse(await readFile(file, 'utf8'))
+
+export async function loadPinnedNpm({ argv = [], cwd = process.cwd() } = {}) {
+  if (process.versions.node !== EXPECTED_NODE_VERSION) {
+    throw new Error(
+      `npm policy requires Node ${EXPECTED_NODE_VERSION}; found ${process.versions.node}. ` +
+      'Use the repository-pinned runtime before installing dependencies.'
+    )
+  }
+
+  const suppliedCli = process.env.npm_execpath
+  if (!suppliedCli) {
+    throw new Error(
+      'npm policy requires npm_execpath. Run the package script through the pinned npm CLI.'
+    )
+  }
+
+  const npmCli = await realpath(path.resolve(suppliedCli))
+  const npmRoot = path.dirname(path.dirname(npmCli))
+  const expectedCli = await realpath(path.join(npmRoot, 'bin', 'npm-cli.js'))
+  if (npmCli !== expectedCli) {
+    throw new Error('npm_execpath does not resolve to npm bin/npm-cli.js')
+  }
+
+  const npmManifest = await readJSON(path.join(npmRoot, 'package.json'))
+  if (npmManifest.name !== 'npm' || npmManifest.version !== EXPECTED_NPM_VERSION) {
+    throw new Error(
+      `npm policy requires npm ${EXPECTED_NPM_VERSION}; found ${npmManifest.version ?? 'unknown'}. ` +
+      'Use the repository-pinned runtime before installing dependencies.'
+    )
+  }
+
+  const requireFromNpm = createRequire(path.join(npmRoot, 'package.json'))
+  for (const [name, version] of EXPECTED_PACKAGES) {
+    const manifest = requireFromNpm(`${name}/package.json`)
+    if (manifest.version !== version) {
+      throw new Error(`npm ${EXPECTED_NPM_VERSION} must bundle ${name} ${version}`)
+    }
+  }
+
+  const Config = requireFromNpm('@npmcli/config')
+  const { definitions, shorthands, flatten } = requireFromNpm('@npmcli/config/lib/definitions')
+  const config = new Config({
+    npmPath: npmRoot,
+    definitions,
+    shorthands,
+    flatten,
+    argv: [process.execPath, npmCli, ...argv],
+    cwd,
+  })
+  await config.load()
+
+  return {
+    npmCli,
+    npmRoot,
+    config,
+    Arborist: requireFromNpm('@npmcli/arborist'),
+    npa: requireFromNpm('npm-package-arg'),
+    pacote: requireFromNpm('pacote'),
+    ssri: requireFromNpm('ssri'),
+  }
+}
