new file mode 100644
index 0000000000000000000000000000000000000000..788c0c42e9b672513d3f1b35e31b82cf2c127639
--- /dev/null
+++ b/scripts/check-npm-install-policy.mjs
@@ -0,0 +1,153 @@
+import { readdir, readFile } from 'node:fs/promises'
+import { createRequire } from 'node:module'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const repoRoot = path.dirname(path.dirname(fileURLToPath(import.meta.url)))
+const frontendRoot = path.join(repoRoot, 'frontend')
+const requireFrontend = createRequire(path.join(frontendRoot, 'package.json'))
+const yaml = requireFrontend('yaml')
+const yamlVersion = requireFrontend('yaml/package.json').version
+if (yamlVersion !== '2.9.0' || typeof yaml.parse !== 'function') {
+  throw new Error(`npm install policy requires the reviewed yaml 2.9.0 parse API; found ${yamlVersion}`)
+}
+const parseYaml = yaml.parse
+
+const read = relative => readFile(path.join(repoRoot, relative), 'utf8')
+
+function check(condition, message, failures) {
+  if (!condition) failures.push(message)
+}
+
+function shellCommands(run) {
+  return run
+    .split('\n')
+    .map(line => line.trim())
+    .filter(line => line && !line.startsWith('#'))
+}
+
+function isNpmAcquisition(line) {
+  const words = line.replace(/^\(+/, '').split(/\s+/)
+  const npmIndex = words.indexOf('npm')
+  if (npmIndex < 0 || words[npmIndex + 1] === 'run') return false
+  return words.slice(npmIndex + 1).some(word => ['ci', 'install'].includes(word))
+}
+
+function invokesNpx(line) {
+  return line.replace(/^\(+/, '').split(/\s+/).includes('npx')
+}
+
+async function checkWorkflows(failures) {
+  const files = (await readdir(path.join(repoRoot, '.github/workflows')))
+    .filter(file => file.endsWith('.yml') || file.endsWith('.yaml'))
+    .map(file => `.github/workflows/${file}`)
+  let canonicalInstalls = 0
+  let cssModulesTests = 0
+  let cssModulesHmrTests = 0
+  for (const file of files) {
+    const workflow = parseYaml(await read(file))
+    for (const [jobName, job] of Object.entries(workflow.jobs ?? {})) {
+      const steps = job.steps ?? []
+      const setupIndexes = []
+      const bootstrapIndexes = []
+      for (const [index, step] of steps.entries()) {
+        if (typeof step.uses === 'string' && step.uses.startsWith('actions/setup-node@')) {
+          setupIndexes.push(index)
+          check(step.with?.['node-version'] === '24.21.0', `${file}:${jobName} must pin Node 24.21.0`, failures)
+        }
+        if (typeof step.run !== 'string') continue
+        for (const command of shellCommands(step.run)) {
+          if (command === 'npm install --global --no-audit --no-fund --loglevel=error npm@12.0.2') {
+            bootstrapIndexes.push(index)
+            continue
+          }
+          check(!isNpmAcquisition(command), `${file}:${jobName} bypasses the canonical npm installer: ${command}`, failures)
+          if (command.startsWith('npm run deps:ci')) canonicalInstalls += 1
+          if (command === 'npm run css-modules:policy:test') cssModulesTests += 1
+          if (command === 'npm run css-modules:policy:test -- --hmr') cssModulesHmrTests += 1
+          check(!invokesNpx(command), `${file}:${jobName} lets npx acquire a runtime package: ${command}`, failures)
+        }
+      }
+      for (const setupIndex of setupIndexes) {
+        check(
+          bootstrapIndexes.some(index => index > setupIndex),
+          `${file}:${jobName} must pin npm 12.0.2 after setup-node`,
+          failures
+        )
+      }
+    }
+  }
+  check(canonicalInstalls === 8, `expected 8 workflow deps:ci calls, found ${canonicalInstalls}`, failures)
+  check(cssModulesTests === 1, `expected one workflow CSS Modules pipeline test, found ${cssModulesTests}`, failures)
+  check(cssModulesHmrTests === 1, `expected one workflow CSS Modules HMR test, found ${cssModulesHmrTests}`, failures)
+}
+
+async function checkPackage(failures) {
+  const manifest = JSON.parse(await read('frontend/package.json'))
+  check(manifest.packageManager === 'npm@12.0.2', 'packageManager must pin npm 12.0.2', failures)
+  check(manifest.engines?.node === '24.21.0', 'engines.node must pin Node 24.21.0', failures)
+  check(manifest.engines?.npm === '12.0.2', 'engines.npm must pin npm 12.0.2', failures)
+  check(manifest.devEngines?.runtime?.version === '24.21.0' && manifest.devEngines.runtime.onFail === 'error', 'devEngines.runtime must enforce Node 24.21.0', failures)
+  check(manifest.devEngines?.packageManager?.version === '12.0.2' && manifest.devEngines.packageManager.onFail === 'error', 'devEngines.packageManager must enforce npm 12.0.2', failures)
+  check(manifest.scripts?.preinstall === 'node ../scripts/npm-lock-policy.mjs --cwd . --allow-missing-lock', 'preinstall must validate direct frontend acquisition', failures)
+  check(manifest.scripts?.['deps:ci'] === 'node ../scripts/npm-install.mjs ci --cwd .', 'deps:ci must use npm-install.mjs', failures)
+  check(manifest.scripts?.['deps:install'] === 'node ../scripts/npm-install.mjs install --cwd .', 'deps:install must use npm-install.mjs', failures)
+  check(manifest.scripts?.['deps:update'] === 'node ../scripts/npm-install.mjs update --cwd .', 'deps:update must use bounded npm-install.mjs update mode', failures)
+  check(manifest.scripts?.['css-modules:policy:test'] === 'node ../scripts/vite-css-modules-selftest.mjs', 'CSS Modules pipeline test must use the committed self-test', failures)
+  check(manifest.devDependencies?.postcss === '8.5.26', 'the CSS Modules self-test must pin its public PostCSS parser to 8.5.26', failures)
+  check(manifest.devDependencies?.['vite-css-modules'] === '1.16.0', 'vite-css-modules must stay pinned to 1.16.0', failures)
+  const approvals = manifest.allowScripts ?? {}
+  check(Object.keys(approvals).length === 1 && approvals['fsevents@2.3.3'] === true, 'only fsevents@2.3.3 may run install scripts', failures)
+}
+
+async function checkTaskfiles(failures) {
+  const taskfile = parseYaml(await read('build/Taskfile.yml'))
+  const tasks = taskfile.tasks ?? {}
+  check(tasks['install:frontend:deps:npm']?.cmds?.includes('npm run deps:ci'), 'Taskfile npm install must use deps:ci', failures)
+  for (const manager of ['bun', 'pnpm', 'yarn']) {
+    const commands = tasks[`install:frontend:deps:${manager}`]?.cmds ?? []
+    check(commands.some(command => String(command).includes('Unsupported frontend installer')), `Taskfile ${manager} install must fail explicitly`, failures)
+    check(!commands.some(command => String(command).includes(`${manager} install`)), `Taskfile ${manager} must not acquire packages`, failures)
+  }
+}
+
+async function checkTextSurfaces(failures) {
+  const npmrc = await read('frontend/.npmrc')
+  for (const setting of [
+    'min-release-age=7',
+    'min-release-age-exclude=',
+    'strict-allow-scripts=true',
+    'engine-strict=true',
+    'package-lock=true',
+    'omit-lockfile-registry-resolved=false',
+  ]) check(npmrc.split('\n').includes(setting), `frontend/.npmrc must contain ${setting}`, failures)
+  check((await read('frontend/.nvmrc')).trim() === '24.21.0', 'frontend/.nvmrc must pin Node 24.21.0', failures)
+  const docker = await read('build/docker/Dockerfile.cross')
+  check(docker.includes('npm run deps:ci --silent'), 'Docker cross-build must use deps:ci', failures)
+  check(docker.includes('ARG NODE_VERSION=24.21.0'), 'Docker cross-build must pin Node 24.21.0', failures)
+  check(docker.includes('npm@12.0.2'), 'Docker cross-build must pin npm 12.0.2', failures)
+  check(!docker.includes('cd frontend && npm install'), 'Docker cross-build bypasses deps:ci', failures)
+  for (const file of ['scripts/vendor-markmap.sh', 'scripts/vendor-readability.sh']) {
+    const source = await read(file)
+    check(source.includes('run deps:install -- --cwd "$WORK"'), `${file} must use deps:install`, failures)
+    check(!source.includes('npx esbuild'), `${file} lets npx acquire esbuild`, failures)
+  }
+  check(!(await read('lefthook.yml')).includes('run: npx tsc'), 'lefthook lets npx acquire TypeScript', failures)
+  const viteConfig = await read('frontend/vite.config.ts')
+  check(viteConfig.includes('import { patchCssModules } from "vite-css-modules";'), 'Vite config must import the public patchCssModules entry point', failures)
+  check(viteConfig.includes('plugins: [patchCssModules(), react(),'), 'patchCssModules must run first with default options', failures)
+  const lefthook = await read('lefthook.yml')
+  check(lefthook.includes('npm run css-modules:policy:test'), 'lefthook must run the CSS Modules pipeline regression', failures)
+}
+
+const failures = []
+await checkPackage(failures)
+await checkTaskfiles(failures)
+await checkWorkflows(failures)
+await checkTextSurfaces(failures)
+if (failures.length) {
+  for (const failure of failures) console.error(`npm-install-policy: ${failure}`)
+  process.exitCode = 1
+} else {
+  console.log('npm-install-policy: OK')
+}
diff --git a/scripts/npm-install.mjs b/scripts/npm-install.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ac9d14dabac3ad760ba70359fe1f5f604e827c4b
--- /dev/null
+++ b/scripts/npm-install.mjs
@@ -0,0 +1,242 @@
+import { spawn } from 'node:child_process'
+import { readFile, realpath } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import { validateLock } from './npm-lock-policy.mjs'
+import { loadPinnedNpm } from './npm-runtime.mjs'
+
+const LOGLEVELS = new Set(['silent', 'error', 'warn', 'notice', 'http', 'info', 'verbose', 'silly'])
+const DEPENDENCY_FIELDS = ['dependencies', 'devDependencies', 'optionalDependencies', 'peerDependencies']
+
+function parseArgs(args) {
+  const command = args.shift()
+  if (!['ci', 'install', 'update'].includes(command)) {
+    throw new Error('npm installer command must be ci, install, or update')
+  }
+  let cwd = process.cwd()
+  const forwarded = []
+  for (let i = 0; i < args.length; i += 1) {
+    if (args[i] === '--cwd') {
+      if (!args[i + 1]) throw new Error('--cwd requires a path')
+      cwd = path.resolve(args[i + 1])
+      i += 1
+    } else if (args[i] === '--') {
+      forwarded.push(...args.slice(i + 1))
+      break
+    } else {
+      forwarded.push(args[i])
+    }
+  }
+  return { command, cwd, forwarded }
+}
+
+function isRegistrySpec(spec) {
+  return spec?.registry === true && (spec.type !== 'alias' || spec.subSpec?.registry === true)
+}
+
+function parseForwarded(args, command, npa, cwd) {
+  const displayArgs = []
+  const packageArgs = []
+  let packageLockOnly = false
+  let ignoreScripts = false
+  for (let i = 0; i < args.length; i += 1) {
+    const arg = args[i]
+    if (['--no-audit', '--no-fund', '--silent'].includes(arg)) {
+      displayArgs.push(arg)
+    } else if (arg === '--package-lock-only') {
+      if (command === 'ci') throw new Error('npm ci does not accept --package-lock-only')
+      packageLockOnly = true
+    } else if (arg === '--ignore-scripts') {
+      ignoreScripts = true
+    } else if (arg === '--loglevel') {
+      const value = args[i + 1]
+      if (!LOGLEVELS.has(value)) throw new Error('npm installer refuses invalid --loglevel')
+      displayArgs.push(`--loglevel=${value}`)
+      i += 1
+    } else if (arg.startsWith('--loglevel=')) {
+      const value = arg.slice('--loglevel='.length)
+      if (!LOGLEVELS.has(value)) throw new Error('npm installer refuses invalid --loglevel')
+      displayArgs.push(arg)
+    } else if (arg.startsWith('-')) {
+      throw new Error(`npm installer refuses unsupported argument: ${arg.split('=')[0]}`)
+    } else {
+      if (command === 'ci') throw new Error('npm ci does not accept package arguments')
+      let spec
+      try {
+        spec = npa(arg, cwd)
+      } catch {
+        throw new Error('npm installer refuses an invalid package argument')
+      }
+      if (!isRegistrySpec(spec)) {
+        throw new Error('npm installer refuses a non-registry package argument')
+      }
+      if (command === 'update' && arg !== spec.name) {
+        throw new Error('npm update accepts explicit bare package names only')
+      }
+      packageArgs.push(arg)
+    }
+  }
+  if (command === 'update' && packageArgs.length === 0) {
+    throw new Error('npm update requires at least one explicit bare package name')
+  }
+  return { displayArgs, packageArgs, packageLockOnly, ignoreScripts }
+}
+
+async function validateDeclaredSpecs(cwd, npa) {
+  let manifest
+  try {
+    manifest = JSON.parse(await readFile(path.join(cwd, 'package.json'), 'utf8'))
+  } catch {
+    throw new Error(`npm installer requires a valid ${path.join(cwd, 'package.json')}`)
+  }
+  if (manifest.workspaces !== undefined) {
+    throw new Error('npm installer refuses workspace package acquisition')
+  }
+  for (const field of DEPENDENCY_FIELDS) {
+    const dependencies = manifest[field]
+    if (dependencies === undefined) continue
+    if (!dependencies || typeof dependencies !== 'object' || Array.isArray(dependencies)) {
+      throw new Error(`npm installer requires package.json ${field} to be an object`)
+    }
+    for (const [name, rawSpec] of Object.entries(dependencies)) {
+      let spec
+      try {
+        spec = typeof rawSpec === 'string' ? npa.resolve(name, rawSpec, cwd) : null
+      } catch {
+        spec = null
+      }
+      if (!isRegistrySpec(spec)) {
+        throw new Error(`npm installer refuses non-registry ${field} entry ${name}`)
+      }
+    }
+  }
+}
+
+function enforcedArgs(cwd, { packageLockOnly, ignoreScripts }) {
+  return [
+    `--prefix=${cwd}`,
+    '--global=false',
+    '--workspaces=false',
+    '--package-lock=true',
+    `--package-lock-only=${packageLockOnly}`,
+    '--omit-lockfile-registry-resolved=false',
+    '--min-release-age=7',
+    '--min-release-age-exclude=',
+    '--strict-allow-scripts=true',
+    '--dangerously-allow-all-scripts=false',
+    `--ignore-scripts=${ignoreScripts}`,
+    '--allow-directory=none',
+    '--allow-file=none',
+    '--allow-git=none',
+    '--allow-remote=none',
+  ]
+}
+
+function validateEffectiveConfig(config, cwd, expected) {
+  const actual = path.resolve(config.get('prefix'))
+  if (
+    actual !== cwd ||
+    config.get('global') !== false ||
+    config.get('location') !== 'user' ||
+    !config.isDefault('location')
+  ) {
+    throw new Error('npm installer effective target differs from the validated project directory')
+  }
+  if (
+    config.get('workspaces') !== false ||
+    config.get('package-lock') !== true ||
+    config.get('package-lock-only') !== expected.packageLockOnly ||
+    config.get('omit-lockfile-registry-resolved') !== false ||
+    config.get('min-release-age') !== 7 ||
+    config.flat.minReleaseAgeExclude?.length !== 0 ||
+    config.get('strict-allow-scripts') !== true ||
+    config.get('dangerously-allow-all-scripts') !== false ||
+    config.get('ignore-scripts') !== expected.ignoreScripts ||
+    config.get('allow-directory') !== 'none' ||
+    config.get('allow-file') !== 'none' ||
+    config.get('allow-git') !== 'none' ||
+    config.get('allow-remote') !== 'none'
+  ) {
+    throw new Error('npm installer could not enforce the locked-package policy')
+  }
+}
+
+const run = (executable, args, options) => new Promise((resolve, reject) => {
+  const child = spawn(executable, args, options)
+  child.once('error', reject)
+  child.once('exit', (code, signal) => resolve({ code, signal }))
+})
+
+async function runNpm(runtime, args, cwd) {
+  const result = await run(process.execPath, [runtime.npmCli, ...args], {
+    cwd,
+    env: process.env,
+    stdio: 'inherit',
+  })
+  if (result.signal) {
+    process.kill(process.pid, result.signal)
+    return false
+  }
+  if (result.code !== 0) {
+    process.exitCode = result.code ?? 1
+    return false
+  }
+  return true
+}
+
+async function runtimeFor(command, cwd, displayArgs, packageArgs, expected) {
+  const args = [command, ...packageArgs, ...displayArgs, ...enforcedArgs(cwd, expected)]
+  const runtime = await loadPinnedNpm({ argv: args, cwd })
+  validateEffectiveConfig(runtime.config, cwd, expected)
+  return { args, runtime }
+}
+
+async function main() {
+  const parsed = parseArgs(process.argv.slice(2))
+  const cwd = await realpath(parsed.cwd)
+  const initial = await loadPinnedNpm({ cwd })
+  const forwarded = parseForwarded(parsed.forwarded, parsed.command, initial.npa, cwd)
+  forwarded.ignoreScripts ||= initial.config.get('ignore-scripts') === true
+  await validateDeclaredSpecs(cwd, initial.npa)
+
+  if (parsed.command === 'ci') {
+    const phase = await runtimeFor('ci', cwd, forwarded.displayArgs, [], {
+      packageLockOnly: false,
+      ignoreScripts: forwarded.ignoreScripts,
+    })
+    await validateLock({ cwd, npmArgs: phase.args })
+    await runNpm(phase.runtime, phase.args, cwd)
+    return
+  }
+
+  const nativeCommand = parsed.command === 'update' ? 'update' : 'install'
+  const resolution = await runtimeFor(
+    nativeCommand,
+    cwd,
+    forwarded.displayArgs,
+    forwarded.packageArgs,
+    { packageLockOnly: true, ignoreScripts: true }
+  )
+  await validateLock({
+    cwd,
+    allowMissingLock: parsed.command === 'install',
+    npmArgs: resolution.args,
+  })
+  if (!(await runNpm(resolution.runtime, resolution.args, cwd))) return
+
+  const materialization = await runtimeFor('ci', cwd, forwarded.displayArgs, [], {
+    packageLockOnly: false,
+    ignoreScripts: forwarded.ignoreScripts,
+  })
+  await validateLock({ cwd, npmArgs: materialization.args })
+  if (forwarded.packageLockOnly) return
+  await runNpm(materialization.runtime, materialization.args, cwd)
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  main().catch(error => {
+    console.error(error.message)
+    process.exitCode = 1
+  })
+}
