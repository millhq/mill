{
  "name": "mill-frontend",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:frame": "MILL_FRAME_ENTRY=activation vite build --config vite.config.frame.ts --mode production && MILL_FRAME_ENTRY=bootstrap vite build --config vite.config.frame.ts --mode production && MILL_FRAME_ENTRY=measure vite build --config vite.config.frame.ts --mode production",
    "build:dev": "tsc && vite build --minify false --mode development && npm run build:frame",
    "build": "tsc && vite build --mode production && npm run build:frame",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "NODE_OPTIONS=--throw-deprecation vitest run --coverage",
    "boundaries": "depcruise -c .dependency-cruiser.cjs src",
    "plugin:conform": "vitest run src/plugins/conformance.test.ts",
    "plugin:typecheck": "tsc -p tsconfig.plugins.json",
    "plugin:lint": "cd .. && eslint --no-error-on-unmatched-pattern --config frontend/eslint.plugins.config.js examples/plugins/*/*.js --max-warnings 0",
    "sdk:build": "tsc -p tsconfig.sdk.json && mv plugin-sdk/sdk.d.ts plugin-sdk/index.d.ts",
    "docs:sdk": "typedoc",
    "docs:commands": "vitest run src/shared/commandsDeclaration.test.ts --update"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@faker-js/faker": "^10.6.0",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "@primer/octicons-react": "^19.33.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.38.0",
    "@wailsio/runtime": "3.0.0-beta.18",
    "@xyflow/react": "^12.11.6",
    "anser": "^2.3.5",
    "copy-to-clipboard": "^4.0.2",
    "cronstrue": "^3.24.0",
    "elkjs": "^0.12.0",
    "fuzzysort": "^4.0.2",
    "genson-js": "^0.0.8",
    "i18next": "^26.4.2",
    "lodash": "^4.18.1",
    "marked": "^16.4.2",
    "mermaid": "^12.0.0",
    "modern-screenshot": "4.7.0",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.6",
    "randexp": "^0.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-i18next": "^17.0.13",
    "react-is": "^19.2.8",
    "react-querybuilder": "^8.23.1",
    "react-resizable-panels": "^4.12.4",
    "react-responsive-carousel": "^3.2.23",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4",
    "zod-schema-faker": "^2.1.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "1.63.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "4.13.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
